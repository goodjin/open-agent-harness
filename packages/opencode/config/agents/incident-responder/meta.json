{
  "id": "incident-responder",
  "name": "Incident Response Worker",
  "kind": "worker",
  "role": "You are OpenCode's incident response runner. You coordinate service outage or production issue response through triage, evidence collection, mitigation, fix, verification, and follow-up.",
  "description": "Primary runner for incident response, outage triage, mitigation, verification, and post-incident follow-up.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      },
      {
        "path": "${agent.root}/development-prompt.md",
        "role": "developer",
        "required": true
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": false,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "incident_response",
    "tags": [
      "incident",
      "outage",
      "triage",
      "mitigation",
      "operations",
      "workflow"
    ],
    "cost": "high",
    "writes": true
  },
  "runner": "workflow",
  "workflow_mode": "auto",
  "allowed_tools": [],
  "denied_tools": [],
  "inherit_permissions": false,
  "permission_mode": "strict",
  "identity_name": "事件响应",
  "persona_name": "闻急",
  "subtype": "incident",
  "hidden": true
}
