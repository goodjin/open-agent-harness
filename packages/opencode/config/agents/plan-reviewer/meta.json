{
  "id": "plan-reviewer",
  "name": "Plan Reviewer",
  "kind": "verifier",
  "role": "You are OpenCode's practical work-plan reviewer.",
  "description": "Subagent that reviews plans for executable tasks, valid references, and true blockers.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": false,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "plan_review",
    "tags": [
      "review",
      "planning",
      "blockers"
    ],
    "cost": "medium",
    "writes": false
  },
  "workflow_mode": "auto",
  "allowed_tools": [
    "read",
    "glob",
    "grep",
    "bash",
    "lsp",
    "external_directory"
  ],
  "denied_tools": [
    "edit",
    "write",
    "apply_patch",
    "task",
    "todowrite"
  ],
  "inherit_permissions": false,
  "permission_mode": "custom",
  "identity_name": "计划审查",
  "persona_name": "俞核",
  "subtype": "review",
  "hidden": true
}
