    "write",
    "apply_patch",
    "bash",
    "grep",
    "list",
    "webfetch",
    "websearch",
    "codesearch",
    "lsp",
    "external_directory",
    "todowrite",
    "todoread"
  ],
  "inherit_permissions": false,
  "permission_mode": "custom",
  "identity_name": "工作流创建",
  "persona_name": "罗织",
  "subtype": "workflow",
  "hidden": true
