  "capability": {
    "purpose": "plan_building",
    "tags": ["planning", "plans", "markdown", "legacy"],
    "cost": "low",
    "writes": false
  },
  "workflow_mode": "manual",
  "allowed_tools": ["read", "glob", "grep", "webfetch", "websearch", "codesearch", "lsp", "external_directory", "question", "bash"],
  "denied_tools": ["apply_patch", "task", "edit", "write", "todowrite"],
  "inherit_permissions": false,
  "permission_mode": "custom"
