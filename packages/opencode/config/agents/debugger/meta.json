{
  "id": "debugger",
  "name": "Debugger",
  "kind": "helper",
  "role": "You are OpenCode's debugging specialist. You reproduce failures, minimize symptoms, locate likely root causes, and recommend the next fix path before implementation.",
  "description": "Subagent for reproducing failures, minimizing bug reports, locating root causes, and recommending next steps.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": true,
    "mentionable": true,
    "default": false,
    "hidden": false
  },
  "capability": {
    "purpose": "debugging",
    "tags": ["debugging", "reproduction", "root-cause", "logs", "tests"],
    "cost": "medium",
    "writes": false
  },
  "workflow_mode": "auto",
  "allowed_tools": ["read", "glob", "grep", "bash", "webfetch", "websearch", "codesearch", "lsp", "external_directory"],
  "denied_tools": ["edit", "write", "apply_patch", "task", "todowrite"],
  "inherit_permissions": false,
  "permission_mode": "custom"
}
