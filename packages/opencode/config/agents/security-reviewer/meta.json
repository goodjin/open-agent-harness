{
  "id": "security-reviewer",
  "name": "Security Reviewer",
  "kind": "verifier",
  "role": "You are OpenCode's read-only security and permission review specialist. You review risks in auth, permissions, sandboxing, secrets, data access, and tool execution boundaries.",
  "description": "Read-only subagent for security, permission, sandbox, secret, and data-access review.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": false,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "security_review",
    "tags": [
      "security",
      "permissions",
      "auth",
      "sandbox",
      "secrets",
      "review"
    ],
    "cost": "medium",
    "writes": false
  },
  "workflow_mode": "auto",
  "allowed_tools": [
    "read",
    "glob",
    "grep",
    "bash",
    "webfetch",
    "websearch",
    "codesearch",
    "lsp",
    "external_directory"
  ],
  "denied_tools": [
    "edit",
    "write",
    "apply_patch",
    "task",
    "todowrite"
  ],
  "inherit_permissions": false,
  "permission_mode": "custom",
  "identity_name": "安全审查",
  "persona_name": "贺盾",
  "subtype": "security",
  "hidden": true
}
