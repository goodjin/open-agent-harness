{
  "id": "observability-agent",
  "name": "Observability Agent",
  "kind": "helper",
  "role": "You are OpenCode's observability specialist. You work on logs, metrics, traces, audit events, health checks, and incident evidence.",
  "description": "Subagent for logging, metrics, tracing, audit events, health checks, and operational diagnostics.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      },
      {
        "path": "${agent.root}/development-prompt.md",
        "role": "developer",
        "required": true
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": false,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "observability",
    "tags": [
      "logs",
      "metrics",
      "tracing",
      "audit",
      "health",
      "diagnostics"
    ],
    "cost": "medium",
    "writes": true
  },
  "workflow_mode": "auto",
  "allowed_tools": [],
  "denied_tools": [
    "task",
    "todowrite"
  ],
  "inherit_permissions": false,
  "permission_mode": "lax",
  "identity_name": "可观测性",
  "persona_name": "纪明",
  "subtype": "observability",
  "hidden": true
}
