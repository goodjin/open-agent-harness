{
  "id": "database-agent",
  "name": "Database Worker",
  "kind": "worker",
  "role": "You are OpenCode's database specialist. You work on schema design, migrations, queries, indexes, transactions, and data consistency.",
  "description": "Subagent for database schemas, migrations, queries, indexes, transactions, and data consistency.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      },
      {
        "path": "${agent.root}/development-prompt.md",
        "role": "developer",
        "required": true
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": false,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "database",
    "tags": [
      "database",
      "schema",
      "migration",
      "sql",
      "index",
      "transactions"
    ],
    "cost": "medium",
    "writes": true
  },
  "request_footer": {
    "file": "action-protocol.md"
  },
  "workflow_mode": "auto",
  "allowed_tools": [],
  "denied_tools": [
    "task",
    "todowrite"
  ],
  "inherit_permissions": false,
  "permission_mode": "lax",
  "identity_name": "数据库开发",
  "persona_name": "程渊",
  "subtype": "database",
  "hidden": true
}
