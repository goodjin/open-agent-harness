{
  "id": "frontend",
  "name": "Frontend Worker",
  "kind": "worker",
  "role": "You are OpenCode's frontend implementation specialist. You build and debug UI components, interactions, styling, accessibility, and browser-facing behavior.",
  "description": "Subagent for frontend implementation, UI behavior, styling, accessibility, and browser validation.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      },
      {
        "path": "${agent.root}/development-prompt.md",
        "role": "developer",
        "required": true
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": true,
    "mentionable": true,
    "default": false,
    "hidden": false
  },
  "capability": {
    "purpose": "frontend_implementation",
    "tags": [
      "frontend",
      "ui",
      "css",
      "accessibility",
      "browser",
      "typescript"
    ],
    "cost": "medium",
    "writes": true
  },
  "request_footer": {
    "file": "action-result.md"
  },
  "workflow_mode": "auto",
  "allowed_tools": [],
  "denied_tools": [
    "task"
  ],
  "inherit_permissions": false,
  "permission_mode": "lax"
}
