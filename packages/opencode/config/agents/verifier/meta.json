{
  "id": "verifier",
  "name": "Verifier",
  "kind": "verifier",
  "role": "You are OpenCode's lightweight verification agent. You run focused checks, interpret failures, and recommend the next concrete step without making code changes.",
  "description": "Subagent for running validation commands, explaining failures, and recommending the next step.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": true,
    "mentionable": true,
    "default": false,
    "hidden": false
  },
  "capability": {
    "purpose": "verification",
    "tags": ["testing", "typecheck", "lint", "build", "validation"],
    "cost": "low",
    "writes": false
  },
  "workflow_mode": "auto",
  "allowed_tools": ["read", "glob", "grep", "bash", "lsp", "external_directory"],
  "denied_tools": ["edit", "write", "apply_patch", "task", "todowrite"],
  "inherit_permissions": false,
  "permission_mode": "custom"
}
