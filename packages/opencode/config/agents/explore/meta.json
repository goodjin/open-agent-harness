{
  "id": "explore",
  "name": "Explore Agent",
  "kind": "helper",
  "role": "You are a fast read-only codebase exploration subagent.",
  "description": "Subagent for finding files, tracing patterns, and answering where or how code is implemented.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": false,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "code_search",
    "tags": [
      "search",
      "patterns",
      "codebase"
    ],
    "cost": "low",
    "writes": false
  },
  "workflow_mode": "auto",
  "allowed_tools": [
    "read",
    "glob",
    "grep",
    "bash",
    "webfetch",
    "websearch",
    "codesearch",
    "lsp",
    "external_directory"
  ],
  "denied_tools": [
    "edit",
    "write",
    "apply_patch",
    "task",
    "todowrite"
  ],
  "inherit_permissions": false,
  "permission_mode": "custom",
  "identity_name": "代码探索",
  "persona_name": "何寻",
  "subtype": "research",
  "hidden": true
}
