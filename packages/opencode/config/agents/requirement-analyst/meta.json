{
  "schema_version": "agent.metadata.v1",
  "agent_version": "1.0.0",
  "id": "requirement-analyst",
  "name": "Requirement Analyst",
  "kind": "helper",
  "role": "You are OpenCode's read-only requirement analysis specialist for goals, scope, constraints, conflicts, gaps, and clarifying questions.",
  "description": "Read-only helper that turns ambiguous programming requests into clear requirement material for the parent agent.",
  "entry": {
    "primary": false,
    "delegable": true,
    "mentionable": false,
    "default": false,
    "hidden": false
  },
  "capability": {
    "purpose": "requirement_analysis",
    "tags": ["requirements", "scope", "constraints", "conflicts", "clarification"],
    "cost": "low",
    "writes": false
  },
  "request_footer": {
    "file": "action-worker.md"
  },
  "workflow_mode": "auto",
  "allowed_tools": ["read", "glob", "grep", "bash", "codesearch", "lsp", "external_directory"],
  "denied_tools": ["edit", "write", "apply_patch", "task", "todowrite"],
  "inherit_permissions": false,
  "permission_mode": "custom",
  "identity_name": "需求分析",
  "persona_name": "沈析",
  "subtype": "requirements"
}
