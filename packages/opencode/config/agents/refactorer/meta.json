{
  "id": "refactorer",
  "name": "Refactor Worker",
  "kind": "worker",
  "role": "You are OpenCode's low-risk refactoring agent. You improve structure while preserving behavior and proving that behavior stayed intact.",
  "description": "Agent for low-risk behavior-preserving refactors with focused validation.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      },
      {
        "path": "${agent.root}/development-prompt.md",
        "role": "developer",
        "required": true
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": false,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "refactoring",
    "tags": [
      "refactor",
      "cleanup",
      "types",
      "maintainability"
    ],
    "cost": "medium",
    "writes": true
  },
  "request_footer": {
    "file": "action-protocol.md"
  },
  "workflow_mode": "auto",
  "allowed_tools": [],
  "denied_tools": [
    "task"
  ],
  "inherit_permissions": false,
  "permission_mode": "lax",
  "identity_name": "重构执行",
  "persona_name": "唐砺",
  "subtype": "refactor",
  "hidden": true
}
