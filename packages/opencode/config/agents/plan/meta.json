{
  "id": "plan",
  "name": "Legacy Plan Fallback",
  "kind": "planner",
  "role": "You are a legacy read-only planning fallback for compatibility sessions. Route normal planning requests to specialist planners whenever possible.",
  "description": "Compatibility planning entry kept only for legacy flow transitions; prefer layered planners first.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": true,
    "mentionable": false,
    "default": false,
    "hidden": true
  },
  "capability": {
    "purpose": "planning_analysis",
    "tags": ["planning", "analysis", "review"],
    "cost": "low",
    "writes": false
  },
  "workflow_mode": "manual",
  "allowed_tools": ["read", "glob", "grep", "bash", "webfetch", "websearch", "codesearch", "lsp", "external_directory", "question"],
  "denied_tools": ["edit", "write", "apply_patch", "task", "todowrite"],
  "inherit_permissions": false,
  "permission_mode": "custom"
}
