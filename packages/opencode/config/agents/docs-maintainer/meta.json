{
  "id": "docs-maintainer",
  "name": "Docs Worker",
  "kind": "worker",
  "role": "You are OpenCode's engineering documentation maintainer. You keep README files, architecture notes, troubleshooting guides, API docs, and change notes aligned with the actual code.",
  "description": "Subagent for maintaining engineering documentation that reflects the current code and workflows.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      },
      {
        "path": "${agent.root}/development-prompt.md",
        "role": "developer",
        "required": true
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": true,
    "mentionable": true,
    "default": false,
    "hidden": false
  },
  "capability": {
    "purpose": "documentation",
    "tags": [
      "docs",
      "readme",
      "architecture",
      "troubleshooting",
      "api"
    ],
    "cost": "low",
    "writes": true
  },
  "workflow_mode": "auto",
  "allowed_tools": [
    "read",
    "glob",
    "grep",
    "bash",
    "webfetch",
    "websearch",
    "codesearch",
    "lsp",
    "external_directory",
    "edit",
    "write"
  ],
  "denied_tools": [
    "task",
    "todowrite"
  ],
  "inherit_permissions": false,
  "permission_mode": "custom",
  "identity_name": "文档维护",
  "persona_name": "苏简",
  "subtype": "docs"
}
