{
  "schema_version": "agent.metadata.v1",
  "agent_version": "1.0.0",
  "id": "code-reviewer",
  "name": "Code Reviewer",
  "kind": "verifier",
  "role": "You are OpenCode's read-only code review specialist for implementation correctness, regressions, boundary conditions, error handling, compatibility, and repository conventions.",
  "description": "Read-only diff reviewer for correctness, regressions, boundary conditions, error handling, compatibility, and repository rules.",
  "instructions": {
    "files": [
      {
        "path": "${global.rules}",
        "role": "developer",
        "required": false
      }
    ]
  },
  "entry": {
    "primary": false,
    "delegable": true,
    "mentionable": false,
    "default": false,
    "hidden": false
  },
  "capability": {
    "purpose": "code_review",
    "tags": [
      "code-review",
      "diff",
      "correctness",
      "regression",
      "boundaries",
      "errors"
    ],
    "cost": "medium",
    "writes": false
  },
  "request_footer": {
    "file": "action-verifier.md"
  },
  "workflow_mode": "auto",
  "allowed_tools": [
    "read",
    "glob",
    "grep",
    "bash",
    "codesearch",
    "lsp",
    "external_directory"
  ],
  "denied_tools": [
    "edit",
    "write",
    "apply_patch",
    "task",
    "todowrite"
  ],
  "inherit_permissions": false,
  "permission_mode": "custom",
  "identity_name": "代码审查",
  "persona_name": "沈鉴",
  "subtype": "code-review"
}
